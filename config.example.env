# prbot settings (read by prbot.py and the bin/ scripts).
# Copy this file to config.env and fill it in. config.env is ignored by git.

# Your GitHub login: whose review requests, PRs and @mentions count. Your own comments are ignored.
# Empty = asked from GitHub with your `gh` login.
GH_USER=

# Your clone of each watched repo, as OWNER/REPO=PATH (comma-separated). Claude starts there, so it uses
# the repo's CLAUDE.md and skills (e.g. /review). Repos without an entry are skipped.
# Example: REPO_DIRS=acme/widgets=~/src/widgets,acme/gears=~/src/gears
REPO_DIRS=

# Permission mode for the tabs: auto (recommended) or manual. The bypass modes are refused.
PERMISSION_MODE=auto

# Seconds between polls. Search allows 30 calls/min; one poll uses 4-5.
POLL_SECS=60

# At most this many prbot tabs at once; extra ones wait in the queue.
MAX_JOBS=3

# After you say "close the tab", wait this many seconds (typing anything cancels the close).
CLOSE_GRACE_SECS=15

# Look back this far past the last poll, because GitHub search takes a while to index new comments.
LAG_SECS=300

# Activity from these logins (comma-separated) is ignored. Bot accounts are always ignored.
IGNORE_AUTHORS=Copilot

# Where the poller and the Claude tabs live. With auto (both), ./bin/start joins the session you type it in,
# beside your own tabs. Typed outside any session, it uses prbot's own session, "prbot", and starts it in the
# background if it isn't running. prbot remembers where (in the file `started`), so every other command looks
# there, wherever you type it.
# MUX: auto, tos or zellij. They take the same commands. Outside any session, auto takes the one whose "prbot"
# session is running, else the only one installed.
MUX=auto

# SESSION: auto, or a session's name to always use that one. (Older configs call this ZELLIJ_SESSION.)
# Joining your own session means ending it (Ctrl+q in tos) ends the poller and its tabs too; detaching is fine.
SESSION=auto

# Optional: model for the tabs (empty = your Claude Code default).
CLAUDE_MODEL=

# Effort level for prbot tabs only: low, medium, high, xhigh or max (empty = your default).
# It's passed as `claude --effort`, which applies to that session only, so Claude started anywhere
# else keeps your normal default.
CLAUDE_EFFORT=

# Optional: also send notifications to your phone via ntfy.sh/<topic>.
# This sends PR titles to ntfy.sh, and anyone who knows the topic can read them. Pick a long random name.
NTFY_TOPIC=

# The first message prbot types into each Claude tab. Empty = prbot's own, shown in each comment.
# One line each. Placeholders: {n} the PR number; {url} the comment you were mentioned in (reply);
# {sha} the commit your last review was on and {intro} why the tab opened (rereview); {note} the
# worktree's state, often empty (fix); {prbot} this folder. Write {{ and }} for braces.
# prbot always adds a last sentence telling Claude how to close the tab; that part can't be changed.

# Review PR #{n}. Wait for me before posting anything to GitHub.
MESSAGE_REVIEW=

# {intro} Pull the PR and check whether the author's replies and any new commits resolve my review comments (my last review was on commit {sha}; threads: {prbot}/bin/pr-threads {n}). Wait for me before posting anything to GitHub.
MESSAGE_REREVIEW=

# Address the reviewers' comments on my PR #{n}. You're in its branch's worktree (threads: {prbot}/bin/pr-threads {n}).{note} Wait for me before pushing or posting anything to GitHub.
MESSAGE_FIX=

# I was mentioned on PR #{n}: {url} (threads: {prbot}/bin/pr-threads {n}). Draft my reply and wait for me before posting it.
MESSAGE_REPLY=
